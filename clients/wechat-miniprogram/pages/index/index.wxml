<view class="page-shell">
  <view class="topbar">
    <view class="brand-block">
      <text class="brand-name">好好回</text>
      <text class="brand-caption">把关心，回得自然</text>
    </view>
    <button class="connection {{connected ? 'online' : (connecting ? 'connecting' : 'offline')}}" disabled="{{busy}}" bindtap="toggleSettings" aria-label="连接设置">
      <view class="status-dot"></view>
      <text>{{connected ? (liveAvailable ? 'AI 在线' : '示例模式') : (connecting ? '连接中' : '未连接')}}</text>
    </button>
  </view>

  <view wx:if="{{showSettings}}" class="settings-sheet">
    <view class="sheet-title">服务连接</view>
    <label class="field-label">服务地址</label>
    <input class="text-input" value="{{apiBaseDraft}}" bindinput="onApiBaseInput" placeholder="https://reply.example.com" />
    <label class="field-label">访问口令</label>
    <input class="text-input" password value="{{accessCodeDraft}}" bindinput="onAccessCodeInput" placeholder="本机开发可留空" />
    <view class="settings-note">模型密钥只保存在服务端；真机不能连接 127.0.0.1。</view>
    <view class="settings-actions">
      <button class="button quiet" bindtap="resetSettings">恢复本机</button>
      <button class="button blue" bindtap="saveSettings">保存连接</button>
    </view>
  </view>

  <view class="composer">
    <view class="input-heading">
      <text class="input-title">回复这条消息</text>
      <text class="input-caption">自动判断语境，生成自然礼貌的回复</text>
    </view>

    <view class="quick-actions">
      <button class="quick-button wechat" disabled="{{busy}}" bindtap="chooseFromChat">
        <text class="quick-title">从微信选内容</text>
        <text class="quick-caption">聊天里的视频或图片</text>
      </button>
      <button class="quick-button paste" disabled="{{busy}}" bindtap="pasteClipboard">
        <text class="quick-title">粘贴文字或文章</text>
        <text class="quick-caption">消息、公众号链接</text>
      </button>
    </view>

    <view class="source-box">
      <textarea class="source-text" value="{{sourceText}}" disabled="{{busy}}" bindinput="onSourceInput" maxlength="6000" auto-height="false" placeholder="也可以在这里输入或粘贴聊天内容" />
      <view class="source-meta">
        <text class="counter">{{sourceCount}} / 6000</text>
        <button wx:if="{{sourceText || attachment}}" class="clear-source" disabled="{{busy}}" bindtap="clearInput">清空</button>
      </view>
    </view>

    <button class="album-button" disabled="{{busy}}" bindtap="chooseMedia">从相册或拍摄选择</button>

    <view wx:if="{{attachment}}" class="attachment-row">
      <image wx:if="{{attachment.kind === 'image'}}" class="attachment-preview image" src="{{attachment.path}}" mode="aspectFill" />
      <video wx:if="{{attachment.kind === 'video'}}" class="attachment-preview video" src="{{attachment.path}}" controls show-center-play-btn />
      <view class="attachment-meta">
        <text class="attachment-name">{{attachment.name}}</text>
        <text class="attachment-detail">{{attachmentDetail}}</text>
      </view>
      <button class="remove-attachment" disabled="{{busy}}" bindtap="removeAttachment">移除</button>
    </view>

    <view wx:if="{{error && !result}}" class="error-message">{{error}}</view>
    <button wx:if="{{!result}}" class="button primary" loading="{{busy}}" disabled="{{busy}}" bindtap="generateReply">{{busy ? '正在准备回复…' : '生成回复'}}</button>
    <view class="privacy-note">只在点击生成后提交；回复由你确认发送。</view>
  </view>

  <view wx:if="{{result}}" id="result" class="result-section">
    <view class="result-heading">
      <text class="result-title">建议这样回复</text>
      <text class="result-caption">可编辑，发送前请核对事实</text>
    </view>
    <textarea class="reply-text" value="{{replyText}}" disabled="{{busy}}" bindinput="onReplyInput" maxlength="1000" />
    <view class="result-actions">
      <button class="button copy" disabled="{{!replyText || busy}}" bindtap="copyReply">复制并回微信</button>
      <button class="button regenerate" loading="{{busy}}" disabled="{{busy}}" bindtap="generateReply">换一句</button>
    </view>
    <view wx:if="{{error}}" class="error-message">{{error}}</view>

    <view class="analysis-block">
      <view class="block-label">内容摘要</view>
      <text selectable>{{result.content_summary}}</text>
    </view>
    <view class="analysis-block">
      <view class="block-label">对方可能想表达</view>
      <view wx:for="{{result.possible_meanings}}" wx:key="*this" class="meaning-item"><view class="meaning-dot"></view><text selectable>{{item}}</text></view>
    </view>
    <view class="analysis-block next-topic">
      <view class="block-label">可以继续聊</view>
      <text selectable>{{result.reply_tip}}</text>
    </view>

    <view wx:if="{{result.evidence}}" class="evidence">
      <button class="evidence-toggle" bindtap="toggleEvidence">{{showEvidence ? '收起识别内容' : '查看识别内容'}}</button>
      <view wx:if="{{showEvidence}}" class="evidence-content"><text selectable>{{evidenceText}}</text></view>
    </view>
    <view class="result-note">{{result.note}}</view>
  </view>
</view>
