<view class="page-shell">
  <view class="masthead">
    <view class="masthead-top">
      <text class="brand-name">好好回</text>
      <button class="settings-trigger" disabled="{{busy}}" bindtap="toggleSettings" aria-label="连接设置">设置</button>
    </view>
    <view class="masthead-title">
      <text>把关心，</text>
      <text>好好回给他们。</text>
    </view>
    <view class="color-rule"><view></view><view></view><view></view></view>
  </view>

  <view class="service-line {{connected ? 'online' : ''}}">
    <view class="status-dot"></view>
    <text>{{connectionLabel}}</text>
  </view>

  <view wx:if="{{showSettings}}" class="settings-sheet">
    <view class="sheet-title">连接服务</view>
    <label class="field-label">服务地址</label>
    <input class="text-input" value="{{apiBaseDraft}}" bindinput="onApiBaseInput" placeholder="https://reply.example.com" />
    <label class="field-label">访问口令</label>
    <input class="text-input" password value="{{accessCodeDraft}}" bindinput="onAccessCodeInput" placeholder="本机开发可留空" />
    <view class="settings-note">模型密钥只保存在服务端；真机不能连接 127.0.0.1。</view>
    <view class="settings-actions">
      <button class="button quiet" bindtap="resetSettings">恢复本机</button>
      <button class="button blue" bindtap="saveSettings">保存连接</button>
    </view>
  </view>

  <view class="composer">
    <view class="section-heading">
      <view>
        <text class="section-number">01</text>
        <text class="section-title">把内容放进来</text>
      </view>
      <text class="section-aside">发送前由你确认</text>
    </view>

    <view class="choice-grid">
      <view class="choice-field">
        <view class="field-label">回复给</view>
        <picker range="{{recipientLabels}}" value="{{recipientIndex}}" disabled="{{busy}}" bindchange="onRecipientChange">
          <view class="picker-value"><text>{{recipientLabels[recipientIndex]}}</text><text class="chevron">⌄</text></view>
        </picker>
      </view>
      <view class="choice-field">
        <view class="field-label">语气</view>
        <picker range="{{toneLabels}}" value="{{toneIndex}}" disabled="{{busy}}" bindchange="onToneChange">
          <view class="picker-value"><text>{{toneLabels[toneIndex]}}</text><text class="chevron">⌄</text></view>
        </picker>
      </view>
    </view>

    <view class="source-box">
      <textarea class="source-text" value="{{sourceText}}" disabled="{{busy}}" bindinput="onSourceInput" maxlength="6000" auto-height="false" placeholder="粘贴聊天文字、公众号链接，或选择图片和视频" />
      <text class="counter">{{sourceCount}} / 6000</text>
    </view>

    <view class="source-actions">
      <button class="source-button paste" disabled="{{busy}}" bindtap="pasteClipboard"><text class="action-mark">贴</text><text>粘贴文字</text></button>
      <button class="source-button chat" disabled="{{busy}}" bindtap="chooseFromChat"><text class="action-mark">聊</text><text>微信文件</text></button>
      <button class="source-button media" disabled="{{busy}}" bindtap="chooseMedia"><text class="action-mark">图</text><text>相册拍摄</text></button>
    </view>

    <view wx:if="{{attachment}}" class="attachment-card">
      <image wx:if="{{attachment.kind === 'image'}}" class="attachment-preview" src="{{attachment.path}}" mode="aspectFit" />
      <video wx:if="{{attachment.kind === 'video'}}" class="attachment-preview" src="{{attachment.path}}" controls show-center-play-btn />
      <view class="attachment-meta">
        <view>
          <text class="attachment-name">{{attachment.name}}</text>
          <text>{{attachmentDetail}}</text>
        </view>
        <button disabled="{{busy}}" bindtap="removeAttachment">移除</button>
      </view>
    </view>

    <view wx:if="{{error}}" class="error-message">{{error}}</view>
    <button class="button primary" loading="{{busy}}" disabled="{{busy}}" bindtap="generateReply">{{busy ? '正在认真读…' : (result ? '换一种说法' : '读懂并生成回复')}}</button>
    <view class="privacy-note">只有点击生成，内容才会提交分析。</view>
  </view>

  <view wx:if="{{result}}" id="result" class="result-section">
    <view class="section-heading result-heading">
      <view>
        <text class="section-number">02</text>
        <text class="section-title">已经读懂了</text>
      </view>
      <text class="section-aside">可以继续修改</text>
    </view>

    <view class="summary-block">
      <view class="block-label">内容摘要</view>
      <text selectable>{{result.content_summary}}</text>
    </view>

    <view class="meaning-block">
      <view class="block-label">对方可能想表达</view>
      <view wx:for="{{result.possible_meanings}}" wx:key="*this" class="meaning-item">
        <view class="meaning-dot"></view>
        <text selectable>{{item}}</text>
      </view>
    </view>

    <view class="tip-block">
      <view class="block-label">可以继续聊</view>
      <text selectable>{{result.reply_tip}}</text>
    </view>

    <view wx:if="{{result.evidence}}" class="evidence">
      <button class="evidence-toggle" bindtap="toggleEvidence">{{showEvidence ? '收起识别依据' : '查看识别依据'}}</button>
      <view wx:if="{{showEvidence}}" class="evidence-content"><text selectable>{{evidenceText}}</text></view>
    </view>

    <view class="reply-label-row"><text>建议回复</text><text>改成你的语气再发送</text></view>
    <textarea class="reply-text" value="{{replyText}}" disabled="{{busy}}" bindinput="onReplyInput" maxlength="1000" />
    <button class="button copy" disabled="{{!replyText || busy}}" bindtap="copyReply">复制并回微信</button>
    <view class="result-note">{{result.note}}</view>
  </view>

  <view class="boundary-note">回到聊天后粘贴，发送前由你确认。</view>
</view>
