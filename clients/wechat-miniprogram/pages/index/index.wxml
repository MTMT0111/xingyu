<view class="page-shell">
  <view class="topbar">
    <text class="brand-caption">看懂分享，再回一句</text>
    <button class="settings-trigger" disabled="{{busy}}" bindtap="toggleSettings" aria-label="服务设置">
      <view class="status-dot {{connected ? 'online' : (connecting ? 'connecting' : 'offline')}}"></view>
      <text>设置</text>
    </button>
  </view>

  <view wx:if="{{showSettings}}" class="settings-sheet">
    <view class="sheet-heading">
      <view>
        <view class="sheet-title">服务连接</view>
        <view class="sheet-status">{{connectionLabel}}</view>
      </view>
      <button class="close-settings" bindtap="toggleSettings" aria-label="关闭设置">完成</button>
    </view>
    <label class="field-label">HTTPS 服务地址</label>
    <input class="text-input" value="{{apiBaseDraft}}" bindinput="onApiBaseInput" placeholder="https://reply.example.com" />
    <label class="field-label">访问口令</label>
    <input class="text-input" password value="{{accessCodeDraft}}" bindinput="onAccessCodeInput" placeholder="本机开发可留空" />
    <view class="settings-note">留空可体验离线文字回复；图片、视频与真实 AI 需要服务连接。</view>
    <view class="settings-actions">
      <button class="button secondary" bindtap="resetSettings">离线体验</button>
      <button class="button solid" bindtap="saveSettings">保存</button>
    </view>
  </view>

  <view class="composer">
    <view class="section-heading">
      <text class="section-title">对方说了什么</text>
      <text class="section-caption">文字 · 文章 · 视频</text>
    </view>

    <view class="video-entry">
      <view class="video-entry-copy">
        <text class="video-entry-title">聊天里收到一段视频？</text>
        <text class="video-entry-note">长按视频，选择“用小程序打开”里的知意入口。</text>
      </view>
      <button class="video-entry-button" disabled="{{busy}}" bindtap="showVideoShareGuide">查看转入方式</button>
    </view>

    <view class="source-box">
      <textarea class="source-text" value="{{sourceText}}" disabled="{{busy}}" bindinput="onSourceInput" maxlength="6000" auto-height="false" placeholder="粘贴消息、公众号链接，或从视频卡片进入" />
      <view class="source-meta">
        <text class="counter">{{sourceCount}} / 6000</text>
        <button wx:if="{{sourceText || attachment}}" class="text-button" disabled="{{busy}}" bindtap="clearInput">清空</button>
      </view>
    </view>

    <view class="source-actions">
      <button class="source-action" disabled="{{busy}}" bindtap="chooseFromChat">选聊天文件</button>
      <button class="source-action" disabled="{{busy}}" bindtap="pasteClipboard">粘贴文字</button>
      <button class="source-action" disabled="{{busy}}" bindtap="chooseMedia">相册或拍摄</button>
    </view>

    <view wx:if="{{attachment}}" class="attachment-row">
      <image wx:if="{{attachment.kind === 'image'}}" class="attachment-preview image" src="{{attachment.path}}" mode="aspectFill" />
      <video wx:if="{{attachment.kind === 'video'}}" class="attachment-preview video" src="{{attachment.path}}" controls show-center-play-btn />
      <view class="attachment-meta">
        <text class="attachment-name">{{attachment.name}}</text>
        <text class="attachment-detail">{{attachmentDetail}}</text>
      </view>
      <button class="remove-attachment" disabled="{{busy}}" bindtap="removeAttachment">移除</button>
    </view>

    <button class="context-toggle" disabled="{{busy}}" bindtap="toggleContext">{{showContext ? '− 收起补充' : '+ 补充一句'}}<text class="optional-label">可选</text></button>
    <view wx:if="{{showContext}}" class="context-box">
      <textarea class="context-text" value="{{replyContext}}" disabled="{{busy}}" bindinput="onContextInput" maxlength="200" placeholder="比如：这是妈妈发来的，回短一点。或：这周没空，想婉拒。" />
      <view class="context-note">{{mode === 'live' ? '不用选分类，直接说你的想法。' : '真实 AI 会参考这句话；离线体验使用固定文案。'}}</view>
    </view>

    <view wx:if="{{error && !result}}" class="error-message">{{error}}</view>
    <button wx:if="{{!result}}" class="button primary" loading="{{busy}}" disabled="{{busy}}" bindtap="generateReply">{{busy ? '正在理解内容' : '帮我回一句'}}</button>
    <view wx:if="{{!result}}" class="privacy-note">内容只在你点击后提交，发送前仍由你确认。</view>
  </view>

  <view wx:if="{{result}}" id="result" class="result-section">
    <view class="section-heading">
      <text class="section-title">回复建议</text>
      <text class="section-caption">改成自己的语气再发送</text>
    </view>
    <textarea class="reply-text" value="{{replyText}}" disabled="{{busy}}" bindinput="onReplyInput" maxlength="1000" />
    <view class="result-actions">
      <button class="button primary" disabled="{{!replyText || busy}}" bindtap="copyReply">复制，返回微信</button>
      <button class="button secondary" loading="{{busy}}" disabled="{{busy}}" bindtap="generateReply">换一句</button>
    </view>
    <view wx:if="{{error}}" class="error-message">{{error}}</view>

    <button class="analysis-toggle" bindtap="toggleAnalysis">{{showAnalysis ? '收起理解过程' : '查看理解过程'}}</button>
    <view wx:if="{{showAnalysis}}" class="analysis">
      <view class="analysis-block">
        <view class="block-label">内容摘要</view>
        <text selectable>{{result.content_summary}}</text>
      </view>
      <view class="analysis-block">
        <view class="block-label">可能想表达</view>
        <view wx:for="{{result.possible_meanings}}" wx:key="*this" class="meaning-item"><view class="meaning-dot"></view><text selectable>{{item}}</text></view>
      </view>
      <view class="analysis-block next-topic">
        <view class="block-label">可以继续聊</view>
        <text selectable>{{result.reply_tip}}</text>
      </view>
      <view wx:if="{{result.evidence}}" class="evidence">
        <button class="evidence-toggle" bindtap="toggleEvidence">{{showEvidence ? '收起识别内容' : '查看识别内容'}}</button>
        <view wx:if="{{showEvidence}}" class="evidence-content"><text selectable>{{evidenceText}}</text></view>
      </view>
      <view class="result-note">{{result.note}}</view>
    </view>
  </view>
</view>
