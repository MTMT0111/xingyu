.page-shell {
  width: 100%;
  max-width: 860rpx;
  margin: 0 auto;
  padding: 24rpx 24rpx calc(44rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.plugin-head,
.brand,
.connection-line,
.panel-title,
.picker-row,
.quick-actions,
.settings-actions,
.attachment-meta,
.reply-head {
  display: flex;
  align-items: center;
}

.plugin-head { justify-content: space-between; padding: 4rpx 4rpx 12rpx; }
.brand-seal { width: 64rpx; height: 64rpx; margin-right: 18rpx; display: flex; align-items: center; justify-content: center; border-radius: 12rpx; background: #3d67a7; color: #fff3bd; font-size: 36rpx; transform: rotate(-2deg); }
.brand-name { font-size: 36rpx; line-height: 1.1; font-weight: 600; }
.brand-subtitle { margin-top: 7rpx; color: #738094; font-size: 20rpx; }
.settings-button { width: auto; min-width: 92rpx; min-height: 64rpx; margin: 0; padding: 0 20rpx; border: 1rpx solid #d8e0e8; border-radius: 12rpx; background: #fffdf7; color: #3d67a7; font-size: 24rpx; line-height: 64rpx; }
.connection-line { min-height: 52rpx; padding: 0 6rpx; color: #738094; font-size: 21rpx; }
.status-dot { width: 12rpx; height: 12rpx; margin-right: 12rpx; border-radius: 50%; background: #a5b0b6; }
.status-dot.online { background: #557d68; }

.settings-panel { margin-bottom: 18rpx; padding: 28rpx; border: 1rpx solid #d7e0ec; border-radius: 14rpx; background: #edf3fb; }
.section-title { margin-bottom: 18rpx; color: #304866; font-size: 28rpx; font-weight: 600; }
.field-label { display: block; margin: 14rpx 0 10rpx; color: #738094; font-size: 22rpx; }
.text-input { height: 80rpx; padding: 0 22rpx; border: 1rpx solid #cfdbe8; border-radius: 12rpx; background: #fff; color: #304760; font-size: 26rpx; }
.settings-note { margin-top: 16rpx; color: #65758a; font-size: 21rpx; line-height: 1.6; }
.settings-actions { margin-top: 20rpx; gap: 14rpx; }
.settings-actions .button { flex: 1; }

.panel { overflow: hidden; border: 1rpx solid #dadddf; background: #fffdf7; }
.input-panel { padding: 30rpx; border-radius: 16rpx 16rpx 0 0; }
.result-panel { padding: 30rpx; border-top: 0; border-radius: 0 0 16rpx 16rpx; background: #fbfcfe; }
.panel-title { margin-bottom: 26rpx; color: #304866; font-size: 29rpx; font-weight: 600; }
.step { margin-right: 16rpx; color: #d9776d; font-size: 23rpx; font-weight: 400; }
.honest-note { margin-left: auto; color: #738094; font-size: 19rpx; font-weight: 400; }

.picker-row { gap: 16rpx; }
.picker-field { flex: 1; min-width: 0; }
.picker-value { min-height: 80rpx; padding: 0 20rpx; display: flex; align-items: center; justify-content: space-between; border: 1rpx solid #dce3e9; border-radius: 12rpx; background: #fff; color: #365374; font-size: 27rpx; box-sizing: border-box; }
.source-box { position: relative; margin-top: 22rpx; border: 1rpx solid #d9e1e9; border-radius: 13rpx; background: #fff; }
.source-text { width: 100%; height: 270rpx; padding: 24rpx 24rpx 52rpx; color: #304760; font-size: 30rpx; line-height: 1.7; box-sizing: border-box; }
.counter { position: absolute; right: 18rpx; bottom: 14rpx; color: #929ca8; font-size: 20rpx; }
.quick-actions { margin: 20rpx 0; gap: 12rpx; }
.quick-button { flex: 1; min-height: 76rpx; margin: 0; padding: 0 8rpx; border: 1rpx solid #cfd9e4; border-radius: 12rpx; background: #edf3fb; color: #3d67a7; font-size: 23rpx; line-height: 76rpx; }

.attachment-card { margin: 18rpx 0; padding: 18rpx; border-left: 6rpx solid #f4d36f; background: #fff7d9; }
.attachment-preview { width: 100%; height: 360rpx; border-radius: 8rpx; background: #edf0f2; }
.attachment-meta { margin-top: 14rpx; justify-content: space-between; color: #738094; font-size: 20rpx; }
.attachment-meta > view { min-width: 0; }
.attachment-meta text { display: block; }
.attachment-name { max-width: 480rpx; margin-bottom: 5rpx; overflow: hidden; color: #425a76; font-size: 23rpx; text-overflow: ellipsis; white-space: nowrap; }
.attachment-meta button { width: auto; margin: 0 0 0 14rpx; padding: 0 16rpx; background: transparent; color: #9d493d; font-size: 22rpx; }
.error-message { margin: 18rpx 0; padding: 18rpx 20rpx; border-left: 6rpx solid #d9776d; background: #fff1ed; color: #9d493d; font-size: 23rpx; line-height: 1.6; }

.button { min-height: 88rpx; border-radius: 13rpx; font-size: 27rpx; line-height: 88rpx; }
.button.primary { margin-top: 10rpx; background: #3d67a7; color: #fff; font-weight: 600; }
.button.secondary { background: #3d67a7; color: #fff; }
.button.ghost { border: 1rpx solid #cfd9e4; background: #fff; color: #3d67a7; }
.button.copy { margin: 20rpx 0 0; background: #ffe7a2; color: #604b1e; }
.button[disabled] { opacity: .55; }
.privacy-note { margin-top: 14rpx; color: #738094; font-size: 20rpx; line-height: 1.6; text-align: center; }

.empty-state { min-height: 150rpx; display: flex; align-items: center; color: #738094; font-size: 25rpx; line-height: 1.7; }
.summary-block { padding: 24rpx; border-left: 6rpx solid #a9bdd9; background: #edf3fb; color: #304760; font-size: 27rpx; line-height: 1.75; }
.block-label { margin-bottom: 12rpx; color: #516780; font-size: 22rpx; font-weight: 600; }
.meaning-block { margin-top: 26rpx; }
.meaning-item { display: flex; margin-top: 10rpx; color: #4d627a; font-size: 26rpx; line-height: 1.7; }
.bullet { margin-right: 14rpx; color: #d9776d; }
.tip-block { margin-top: 24rpx; color: #65758a; font-size: 24rpx; line-height: 1.7; }
.evidence { margin-top: 20rpx; }
.evidence-toggle { min-height: 72rpx; margin: 0; padding: 0; background: transparent; color: #3d67a7; font-size: 23rpx; line-height: 72rpx; text-align: left; }
.evidence-content { max-height: 360rpx; overflow: auto; padding: 20rpx; background: #f1f4f7; color: #65758a; font-size: 22rpx; line-height: 1.7; white-space: pre-wrap; }
.reply-head { margin: 30rpx 0 12rpx; justify-content: space-between; color: #355477; font-size: 27rpx; font-weight: 600; }
.reply-head text:last-child { color: #738094; font-size: 20rpx; font-weight: 400; }
.reply-text { width: 100%; height: 220rpx; padding: 22rpx; border: 1rpx solid #cfdbe8; border-radius: 12rpx; background: #fff; color: #304760; font-size: 30rpx; line-height: 1.7; box-sizing: border-box; }
.result-note { margin-top: 18rpx; padding-top: 16rpx; border-top: 1rpx solid #e8ebee; color: #738094; font-size: 20rpx; line-height: 1.65; }
.boundary-note { padding: 26rpx 10rpx; color: #738094; font-size: 20rpx; line-height: 1.7; text-align: center; }

@media (max-width: 360px) {
  .page-shell { padding-right: 18rpx; padding-left: 18rpx; }
  .input-panel, .result-panel { padding: 24rpx 20rpx; }
  .quick-actions { flex-wrap: wrap; }
  .quick-button { min-width: 30%; font-size: 21rpx; }
  .honest-note { display: none; }
}
