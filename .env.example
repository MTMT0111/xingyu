# Copy to .env and configure locally. Never commit real keys.
# Optional Jev classifier. Without this key, the LLM analyzes and replies directly.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
LLM_API_KEY=
# HTTPS base URL, without /chat/completions. Match your provider's docs.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# Other providers: set 1 only if this model supports image_url vision inputs.
# Official DeepSeek Flash is detected automatically.
LLM_VISION=0
# Local video runtime (see MEDIA.md). No third cloud API key is needed for audio.
MEDIA_PYTHON=
MEDIA_PYTHONPATH=
WHISPER_MODEL_PATH=
PORT=4173
# Keep empty for local use. Private WeChat H5 trials require an HTTPS reverse proxy.
PUBLIC_ORIGIN=
# Required with PUBLIC_ORIGIN. 16-128 printable ASCII characters, no spaces.
# HTTP Basic username is trial. Use a random password; never put it in URLs.
TRIAL_PASSWORD=
# Keep 127.0.0.1 behind a reverse proxy. 0.0.0.0 is only for isolated container networking.
BIND_HOST=127.0.0.1
