diff --git a/internal/handlers/script_local_auth_test.go b/internal/handlers/script_local_auth_test.go
new file mode 100644
index 0000000..3149fa4
--- /dev/null
+++ b/internal/handlers/script_local_auth_test.go
@@ -0,0 +1,16 @@
+package handlers
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestLocalTokenPrecedesClientAndEscapesHTML(t *testing.T) {
+	h := &ScriptHandler{localToken: "secret</script>", apiClientJS: []byte("window.clientStarted=true;")}
+	scripts := h.buildInjectedScripts("/web/pages/feed")
+	start := strings.Index(scripts, "window.__WX_LOCAL_TOKEN__=")
+	client := strings.Index(scripts, "window.clientStarted=true")
+	if start < 0 || client < start || strings.Contains(scripts, "secret</script>") {
+		t.Fatal("token missing, unsafe, or initialized after API client")
+	}
+}
