diff --git a/internal/router/local_host_test.go b/internal/router/local_host_test.go
new file mode 100644
index 0000000..d88f3c9
--- /dev/null
+++ b/internal/router/local_host_test.go
@@ -0,0 +1,15 @@
+package router
+
+import (
+	"github.com/qtgolang/SunnyNet/SunnyNet"
+	"net/http/httptest"
+	"testing"
+)
+
+func TestRouterPassesUnrelatedWebAPIThrough(t *testing.T) {
+	r := &APIRouter{}
+	conn := &SunnyNet.HttpConn{Request: httptest.NewRequest("GET", "https://example.org/api/v1/auth/me", nil)}
+	if r.Handle(conn) {
+		t.Fatal("intercepted unrelated site")
+	}
+}
